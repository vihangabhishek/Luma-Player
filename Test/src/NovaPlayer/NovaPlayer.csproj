<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>NovaPlayer</AssemblyName>
    <RootNamespace>NovaPlayer</RootNamespace>
    <ApplicationIcon>Assets/NovaPlayer.ico</ApplicationIcon>
    <Version>1.2.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets/NovaPlayer.ico" />
    <PackageReference Include="LibVLCSharp.WPF" Version="3.10.1" />
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.24" />
  </ItemGroup>
</Project>
