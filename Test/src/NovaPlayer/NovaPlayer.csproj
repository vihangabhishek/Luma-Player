<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>NovaPlayer</AssemblyName>
    <RootNamespace>NovaPlayer</RootNamespace>
    <ApplicationIcon>Assets/NovaPlayer.ico</ApplicationIcon>
    <Version>1.4.0</Version>
    <!-- Keep WPF reflection/XAML support intact: trimming is unsupported for this app. -->
    <PublishTrimmed>false</PublishTrimmed>
    <PublishReadyToRun>false</PublishReadyToRun>
    <!-- Do not ship debugging symbols in retail builds. -->
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <UseAppHost>true</UseAppHost>
    <!-- Windows Desktop uses workstation GC by default; avoid server GC's extra heaps. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets/NovaPlayer.ico" />
    <PackageReference Include="LibVLCSharp.WinForms" Version="3.10.1" />
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.24" />
  </ItemGroup>
</Project>
