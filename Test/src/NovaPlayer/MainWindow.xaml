<Window x:Class="NovaPlayer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        Title="Nova Player — Video &amp; Music" Width="1270" Height="800" MinWidth="950" MinHeight="610"
        Icon="Assets/NovaPlayer.ico" WindowStartupLocation="CenterScreen" Background="#F5F7FC"
        FontFamily="Segoe UI" Closing="Window_Closing" ContentRendered="Window_ContentRendered"
        AllowDrop="True" Drop="Window_Drop">
  <Window.Resources>
    <SolidColorBrush x:Key="Ink" Color="#1F2937"/>
    <SolidColorBrush x:Key="Muted" Color="#69788D"/>
    <SolidColorBrush x:Key="Accent" Color="#3478F6"/>
    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Ink}"/>
      <Setter Property="FontFamily" Value="Segoe UI"/>
    </Style>
    <Style x:Key="NavButton" TargetType="Button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="#52647C"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="15,12"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Margin" Value="0,3"/>
      <Setter Property="Template">
        <Setter.Value><ControlTemplate TargetType="Button">
          <Border Background="{TemplateBinding Background}" CornerRadius="11" Padding="{TemplateBinding Padding}">
            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#EAF1FB"/><Setter Property="Foreground" Value="#2461B7"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="ActionButton" TargetType="Button">
      <Setter Property="Padding" Value="13,9"/>
      <Setter Property="Background" Value="#EBF1FA"/>
      <Setter Property="Foreground" Value="#2D517D"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value><ControlTemplate TargetType="Button">
          <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="10">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="0.85"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
      <Setter Property="Background" Value="#3478F6"/>
      <Setter Property="Foreground" Value="White"/>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Padding" Value="11,9"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Foreground" Value="#1F3554"/>
      <Setter Property="Background" Value="#F7FAFF"/>
      <Setter Property="BorderBrush" Value="#E0E8F3"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Background" Value="White"/>
      <Setter Property="Foreground" Value="#284364"/>
      <Setter Property="Padding" Value="8,5"/>
      <Setter Property="BorderBrush" Value="#DDE7F3"/>
    </Style>
    <Style TargetType="ListBoxItem">
      <Setter Property="Padding" Value="9"/>
      <Setter Property="Margin" Value="0,3"/>
      <Setter Property="Foreground" Value="#264262"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Style.Triggers>
        <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#E3EFFF"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="PaneCard" TargetType="Border">
      <Setter Property="Background" Value="White"/>
      <Setter Property="BorderBrush" Value="#E5EBF4"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="17"/>
      <Setter Property="Padding" Value="21"/>
    </Style>
  </Window.Resources>
  <Grid x:Name="AppRoot" Background="#F5F7FC">
    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid x:Name="ShellGrid" Grid.Row="0" Margin="13,12,13,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="198"/><ColumnDefinition Width="*"/><ColumnDefinition Width="268"/>
      </Grid.ColumnDefinitions>
      <!-- Calm, fixed-width primary navigation -->
      <Border x:Name="NavPanel" Grid.Column="0" Background="White" BorderBrush="#E4EAF4" BorderThickness="1" CornerRadius="17" Padding="12" Margin="0,0,0,0">
        <DockPanel LastChildFill="True">
          <StackPanel DockPanel.Dock="Top">
            <StackPanel Orientation="Horizontal" Margin="7,9,0,29">
              <Border Width="40" Height="40" CornerRadius="12" Background="#3478F6">
                <TextBlock Text="▶" Foreground="White" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <StackPanel Margin="10,2,0,0">
                <TextBlock Text="Nova" FontWeight="Bold" FontSize="19"/>
                <TextBlock Text="PLAYER" Foreground="#3478F6" FontSize="9" FontWeight="Bold"/>
              </StackPanel>
            </StackPanel>
            <TextBlock Text="LIBRARY" Foreground="#9AA8BA" FontSize="10" FontWeight="SemiBold" Margin="10,0,0,10"/>
            <Button x:Name="NavHome" Style="{StaticResource NavButton}" Background="#E8F1FF" Foreground="#246AD6" Content="⌂     Home" Tag="home" Click="Nav_Click"/>
            <Button x:Name="NavMusic" Style="{StaticResource NavButton}" Content="♫     Music" Tag="music" Click="Nav_Click"/>
            <Button x:Name="NavVideos" Style="{StaticResource NavButton}" Content="▸     Videos" Tag="videos" Click="Nav_Click"/>
            <Border Height="1" Background="#EEF2F7" Margin="10,17,10,14"/>
            <TextBlock Text="APP" Foreground="#9AA8BA" FontSize="10" FontWeight="SemiBold" Margin="10,0,0,10"/>
            <Button x:Name="NavSettings" Style="{StaticResource NavButton}" Content="⚙     Settings" Tag="settings" Click="Nav_Click"/>
            <Button x:Name="NavUpdates" Style="{StaticResource NavButton}" Content="↓     Updates" Tag="updates" Click="Nav_Click"/>
            <Button x:Name="NavAbout" Style="{StaticResource NavButton}" Content="ⓘ     About" Tag="about" Click="Nav_Click"/>
          </StackPanel>
          <StackPanel DockPanel.Dock="Bottom" VerticalAlignment="Bottom">
            <Border Background="#F2F6FD" CornerRadius="12" Padding="11" Margin="0,0,0,12">
              <StackPanel>
                <TextBlock Text="OFFLINE &amp; PRIVATE" FontSize="10" FontWeight="Bold" Foreground="#4179CA"/>
                <TextBlock Text="Local playback. No account." FontSize="10" Foreground="#7B8FA9" TextWrapping="Wrap" Margin="0,5,0,0"/>
              </StackPanel>
            </Border>
            <TextBlock Text="NOVA PLAYER · v1.2" Foreground="#A0AEC1" FontSize="10" Margin="9,0,0,6"/>
          </StackPanel>
        </DockPanel>
      </Border>

      <Grid x:Name="MainArea" Grid.Column="1" Margin="13,0">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <DockPanel x:Name="TopHeader" Grid.Row="0" Height="66">
          <TextBlock x:Name="TopStatus" DockPanel.Dock="Right" Text="Ready" TextAlignment="Right" Foreground="#7E91A8" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="270"/>
          <StackPanel VerticalAlignment="Center">
            <TextBlock x:Name="PageTitle" Text="Good to see you" FontSize="21" FontWeight="Bold"/>
            <TextBlock x:Name="PageSubtitle" Text="Your music and movies in one place." FontSize="11" Foreground="#889AAF" Margin="0,3,0,0"/>
          </StackPanel>
        </DockPanel>
        <!-- Player stage plus single-page tab content. No nested glass gradients over video. -->
        <Border x:Name="PlayerContainer" Grid.Row="1" Background="White" BorderBrush="#E4EAF4" BorderThickness="1" CornerRadius="17" ClipToBounds="True">
          <Grid>
            <vlc:VideoView x:Name="VideoSurface" Background="Black" Visibility="Collapsed" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
            <Grid x:Name="EmptyVisual" Visibility="Collapsed" Background="#101B2E">
              <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="▶" FontSize="57" Foreground="#A4CCFF" HorizontalAlignment="Center"/>
                <TextBlock Text="Ready when you are" FontSize="21" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" Margin="0,18,0,7"/>
                <TextBlock Text="Open a song or movie to start playing." Foreground="#A9BAD1" HorizontalAlignment="Center" FontSize="12"/>
                <Button Content="＋ Open media" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Center" Margin="0,18,0,0" Click="OpenFiles_Click"/>
              </StackPanel>
            </Grid>
            <Grid x:Name="MusicVisual" Visibility="Collapsed" Background="#172642">
              <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border Width="142" Height="142" Background="#416FEB" CornerRadius="26">
                  <TextBlock Text="♫" FontSize="82" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="NOW PLAYING" Foreground="#A7C3F6" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,24,0,7" FontSize="10"/>
                <TextBlock x:Name="MusicTitle" Text="Music" Foreground="White" HorizontalAlignment="Center" FontSize="20" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="420"/>
              </StackPanel>
            </Grid>
            <Grid x:Name="HomeDashboard" Visibility="Collapsed" Background="White">
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
              <Border Grid.Row="0" Margin="21,21,21,17" Background="#EDF4FF" CornerRadius="15" Padding="19">
                <DockPanel>
                  <Button DockPanel.Dock="Right" Content="↻ Refresh" Style="{StaticResource ActionButton}" Click="RefreshHome_Click" Margin="12,0,0,0"/>
                  <StackPanel>
                    <TextBlock Text="Your cinema" FontWeight="Bold" FontSize="22" Foreground="#203B64"/>
                    <TextBlock Text="Videos on your device, ready to play." Foreground="#6886AD" FontSize="12" Margin="0,5,0,0"/>
                  </StackPanel>
                </DockPanel>
              </Border>
              <DockPanel Grid.Row="1" Margin="23,0,22,13">
                <TextBlock x:Name="HomeVideoCount" DockPanel.Dock="Right" Text="Scanning…" Foreground="#3478F6" FontSize="11"/>
                <TextBlock x:Name="HomeScanStatus" Text="Looking for your videos" Foreground="#8595AA" FontSize="11"/>
              </DockPanel>
              <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="14,0,13,12">
                  <StackPanel x:Name="HomeNoVideos" Visibility="Collapsed" HorizontalAlignment="Center" Margin="8,42,8,0">
                    <TextBlock Text="▸" HorizontalAlignment="Center" Foreground="#407DDA" FontSize="43"/>
                    <TextBlock Text="No local videos yet" HorizontalAlignment="Center" FontWeight="SemiBold" FontSize="17" Margin="0,10,0,6"/>
                    <TextBlock Text="Choose a file or add your own video folder." HorizontalAlignment="Center" Foreground="#8B9CB0" FontSize="12" Margin="0,0,0,16"/>
                    <Button Content="＋ Open videos" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Center" Click="OpenFiles_Click"/>
                  </StackPanel>
                  <ItemsControl x:Name="HomeVideosList">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Button Width="194" Height="175" Margin="5" BorderThickness="0" Padding="0" Background="Transparent" Cursor="Hand" Click="HomeVideo_Click">
                          <Border BorderBrush="#E7EDF5" BorderThickness="1" CornerRadius="12" ClipToBounds="True" Background="#FFFFFF">
                            <StackPanel>
                              <Grid Height="111" Background="#192B49">
                                <TextBlock Text="▶" FontSize="35" Foreground="#90BAFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"/>
                                <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Background="#CC18345A" Margin="5" CornerRadius="6" Padding="8,4">
                                  <TextBlock Text="▶" Foreground="White" FontSize="11"/>
                                </Border>
                              </Grid>
                              <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="10,9,10,3"/>
                              <TextBlock Text="{Binding Details}" FontSize="10" Foreground="#879AB2" TextTrimming="CharacterEllipsis" Margin="10,0,10,7"/>
                            </StackPanel>
                          </Border>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </ScrollViewer>
            </Grid>
            <Grid x:Name="LibraryLanding" Background="White" Visibility="Collapsed">
              <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="390">
                <Border Background="#EDF4FF" Width="88" Height="88" CornerRadius="23">
                  <TextBlock x:Name="LibraryIcon" Text="♫" Foreground="#3478F6" FontSize="43" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock x:Name="LibraryWelcome" Text="Your Music" FontSize="23" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,22,0,8"/>
                <TextBlock x:Name="LibraryHint" Text="Choose something from your library on the right." Foreground="#8595AA" FontSize="12" TextAlignment="Center" TextWrapping="Wrap"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,23,0,0">
                  <Button Content="＋ Open files" Style="{StaticResource PrimaryButton}" Click="OpenFiles_Click" Margin="0,0,9,0"/>
                  <Button Content="Add folder" Style="{StaticResource ActionButton}" Click="AddFolder_Click"/>
                </StackPanel>
              </StackPanel>
            </Grid>
            <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" Background="#FAFCFF" VerticalScrollBarVisibility="Auto">
              <StackPanel MaxWidth="620" Margin="27">
                <TextBlock Text="Settings" FontSize="26" FontWeight="Bold"/>
                <TextBlock Text="Simple controls for your everyday watching and listening." Foreground="#8899AF" FontSize="12" Margin="0,7,0,21"/>
                <Border Style="{StaticResource PaneCard}">
                  <StackPanel>
                    <TextBlock Text="Playback" FontWeight="SemiBold" FontSize="16"/>
                    <CheckBox x:Name="AutoFullscreenCheck" Content="Automatically open videos in fullscreen" IsChecked="True" Checked="AutoFullscreen_Changed" Unchecked="AutoFullscreen_Changed" Margin="0,19,0,7" FontSize="13"/>
                    <TextBlock Text="Switch this off if you prefer videos to open in a normal window. Press Esc to leave fullscreen." TextWrapping="Wrap" FontSize="11" Foreground="#899BB2" Margin="24,0,0,14"/>
                    <TextBlock Text="Color theme" FontSize="12" FontWeight="SemiBold" Margin="0,6,0,9"/>
                    <ComboBox x:Name="ThemePicker" Width="190" HorizontalAlignment="Left" SelectionChanged="Theme_Changed">
                      <ComboBoxItem Content="Blue" IsSelected="True"/><ComboBoxItem Content="Violet"/>
                      <ComboBoxItem Content="Ocean"/><ComboBoxItem Content="Rose"/><ComboBoxItem Content="Midnight"/>
                    </ComboBox>
                  </StackPanel>
                </Border>
                <Border Style="{StaticResource PaneCard}" Margin="0,14,0,0">
                  <StackPanel>
                    <TextBlock Text="Media Library" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,7"/>
                    <TextBlock Text="Home scans your Videos folder, top-level Downloads, and imported library items. Videos never leave your PC." Foreground="#8193A8" TextWrapping="Wrap" FontSize="12"/>
                    <Button Content="↻ Refresh local videos" Style="{StaticResource ActionButton}" Click="RefreshHome_Click" HorizontalAlignment="Left" Margin="0,14,0,0"/>
                  </StackPanel>
                </Border>
              </StackPanel>
            </ScrollViewer>
            <ScrollViewer x:Name="UpdatesPage" Visibility="Collapsed" Background="#FAFCFF" VerticalScrollBarVisibility="Auto">
              <StackPanel MaxWidth="620" Margin="27">
                <TextBlock Text="Updates" FontSize="26" FontWeight="Bold"/>
                <TextBlock Text="Keep Nova Player up to date, on your terms." FontSize="12" Foreground="#8A9AAF" Margin="0,7,0,23"/>
                <Border Style="{StaticResource PaneCard}">
                  <StackPanel>
                    <TextBlock Text="Nova Player 1.2.0" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock Text="Check GitHub for new official versions. No background downloads or silent installations." Foreground="#8094AA" FontSize="12" TextWrapping="Wrap" Margin="0,10,0,18"/>
                    <Button x:Name="CheckUpdatesButton" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Content="↻ Check for updates" Click="CheckUpdates_Click"/>
                    <Button x:Name="InstallUpdateButton" Style="{StaticResource ActionButton}" HorizontalAlignment="Left" Content="↓ Download &amp; install" Margin="0,11,0,0" Visibility="Collapsed" Click="InstallUpdate_Click"/>
                    <ProgressBar x:Name="UpdateProgress" Visibility="Collapsed" Minimum="0" Maximum="100" Height="6" Margin="0,13,0,0"/>
                    <TextBlock x:Name="UpdateStatus" Text="You decide when to check for updates." Foreground="#8093A9" TextWrapping="Wrap" FontSize="12" Margin="0,15,0,0"/>
                  </StackPanel>
                </Border>
                <TextBlock Text="Updates are downloaded from GitHub and verified with the release's SHA-256 checksum. The normal setup wizard asks for your confirmation." Foreground="#97A5B7" TextWrapping="Wrap" FontSize="11" Margin="4,17,4,0"/>
              </StackPanel>
            </ScrollViewer>
            <ScrollViewer x:Name="AboutPage" Visibility="Collapsed" Background="#FAFCFF">
              <StackPanel MaxWidth="610" Margin="27">
                <TextBlock Text="About Nova Player" FontSize="26" FontWeight="Bold"/>
                <Border Style="{StaticResource PaneCard}" Margin="0,22,0,0">
                  <StackPanel>
                    <TextBlock Text="▶" FontSize="50" Foreground="#3478F6"/>
                    <TextBlock Text="Nova Player" FontWeight="Bold" FontSize="22" Margin="0,12,0,5"/>
                    <TextBlock Text="Your media. Beautifully simple." Foreground="#617A9A" FontSize="13"/>
                    <TextBlock Text="Version 1.2.0 · Technical Preview" Margin="0,16,0,0" FontSize="12" Foreground="#7D92AD"/>
                    <TextBlock Text="A lightweight, offline-first Windows music and video player powered by LibVLC. Fullscreen movies, local video previews, music controls, subtitles and verified optional updates." TextWrapping="Wrap" FontSize="12" Foreground="#6F839E" Margin="0,15,0,0"/>
                    <TextBlock Text="Source code: github.com/vihangaabishek5-lang/Luma-Player" Foreground="#3070D3" FontSize="12" Margin="0,20,0,0"/>
                    <TextBlock Text="Nova Player does not upload your library or local files." TextWrapping="Wrap" Foreground="#96A6B8" FontSize="11" Margin="0,15,0,0"/>
                  </StackPanel>
                </Border>
              </StackPanel>
            </ScrollViewer>
          </Grid>
        </Border>
        <Border x:Name="PlaybackTools" Grid.Row="2" Background="White" BorderBrush="#E4EAF4" BorderThickness="1" CornerRadius="14" Padding="11" Margin="0,11,0,0">
          <DockPanel LastChildFill="False">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
              <Button Style="{StaticResource ActionButton}" Content="Subtitles" Click="Subtitle_Click" Margin="0,0,6,0"/>
              <Button Style="{StaticResource ActionButton}" Content="Snapshot" Click="Snapshot_Click" Margin="0,0,6,0"/>
              <Button Style="{StaticResource ActionButton}" Content="⛶ Fullscreen" Click="Fullscreen_Click"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right" VerticalAlignment="Center">
              <TextBlock Text="Speed" FontSize="11" Foreground="#8A9AAC" VerticalAlignment="Center" Margin="0,0,8,0"/>
              <ComboBox x:Name="SpeedPicker" Width="76" SelectionChanged="Speed_Changed">
                <ComboBoxItem Content="0.5×" Tag="0.5"/><ComboBoxItem Content="0.75×" Tag="0.75"/>
                <ComboBoxItem Content="1×" Tag="1" IsSelected="True"/><ComboBoxItem Content="1.25×" Tag="1.25"/>
                <ComboBoxItem Content="1.5×" Tag="1.5"/><ComboBoxItem Content="2×" Tag="2"/>
              </ComboBox>
              <TextBlock Text="Aspect" VerticalAlignment="Center" FontSize="11" Foreground="#8A9AAC" Margin="12,0,8,0"/>
              <ComboBox x:Name="AspectPicker" Width="91" SelectionChanged="Aspect_Changed">
                <ComboBoxItem Content="Original" Tag="" IsSelected="True"/>
                <ComboBoxItem Content="16:9" Tag="16:9"/>
                <ComboBoxItem Content="4:3" Tag="4:3"/>
                <ComboBoxItem Content="21:9" Tag="21:9"/>
              </ComboBox>
            </StackPanel>
          </DockPanel>
        </Border>
      </Grid>
      <!-- compact library panel -->
      <Border x:Name="LibraryPanel" Grid.Column="2" Background="White" BorderBrush="#E4EAF4" BorderThickness="1" CornerRadius="17" Padding="15">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <DockPanel Grid.Row="0" Margin="2,3,0,15">
            <Button DockPanel.Dock="Right" Content="＋" Style="{StaticResource PrimaryButton}" Click="OpenFiles_Click"/>
            <StackPanel>
              <TextBlock Text="Your Library" FontSize="16" FontWeight="Bold"/>
              <TextBlock x:Name="LibraryCount" Text="0 items" FontSize="11" Foreground="#99A9BB" Margin="0,4,0,0"/>
            </StackPanel>
          </DockPanel>
          <TextBox Grid.Row="1" x:Name="SearchBox" TextChanged="Search_Changed" ToolTip="Search your library" Margin="0,0,0,13"/>
          <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,13">
            <Button x:Name="ShuffleButton" Content="Shuffle: Off" Style="{StaticResource ActionButton}" Click="Shuffle_Click" Margin="0,0,5,0"/>
            <Button x:Name="RepeatButton" Content="Repeat: All" Style="{StaticResource ActionButton}" Click="Repeat_Click"/>
          </StackPanel>
          <ListBox x:Name="Playlist" Grid.Row="3" Background="Transparent" BorderThickness="0" MouseDoubleClick="Playlist_DoubleClick" SelectionChanged="Playlist_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate><DataTemplate>
              <Grid Margin="1,3">
                <Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Width="32" Height="36" CornerRadius="8" Background="#EEF4FD">
                  <TextBlock Text="▶" Foreground="#6499DE" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="8,1,1,0">
                  <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                  <TextBlock Text="{Binding Secondary}" FontSize="10" Foreground="#9BAABC" Margin="0,4,0,0"/>
                </StackPanel>
              </Grid>
            </DataTemplate></ListBox.ItemTemplate>
          </ListBox>
          <StackPanel Grid.Row="4" Margin="0,14,0,0">
            <Button Content="♡ Favorite / unfavorite" Style="{StaticResource ActionButton}" Click="Favorite_Click" Margin="0,0,0,7"/>
            <Button Content="Remove from library" Style="{StaticResource ActionButton}" Click="Remove_Click"/>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
    <!-- playback dock, intentionally kept separate from video surface -->
    <Border x:Name="TransportDock" Grid.Row="1" Margin="13,11,13,13" Padding="17,13" Background="White" BorderBrush="#E4EAF4" BorderThickness="1" CornerRadius="15">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/><ColumnDefinition Width="158"/></Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" VerticalAlignment="Center">
          <TextBlock x:Name="NowTitle" Text="Nothing playing" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
          <TextBlock x:Name="NowMeta" Text="Nova Player" FontSize="11" Foreground="#9AACBF" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
        </StackPanel>
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Content="⏮" Style="{StaticResource ActionButton}" Click="Previous_Click" Margin="0,0,6,0"/>
            <Button Content="−10s" Style="{StaticResource ActionButton}" Click="Back_Click" Margin="0,0,6,0"/>
            <Button x:Name="PlayPauseButton" Content="▶ Play" Style="{StaticResource PrimaryButton}" Click="PlayPause_Click" Margin="0,0,6,0"/>
            <Button Content="+10s" Style="{StaticResource ActionButton}" Click="Forward_Click" Margin="0,0,6,0"/>
            <Button Content="⏭" Style="{StaticResource ActionButton}" Click="Next_Click"/>
          </StackPanel>
          <DockPanel Margin="0,8,0,0">
            <TextBlock x:Name="PositionText" DockPanel.Dock="Left" Width="42" Text="00:00" FontSize="10" Foreground="#8193A9" VerticalAlignment="Center"/>
            <TextBlock x:Name="DurationText" DockPanel.Dock="Right" Width="42" Text="00:00" FontSize="10" Foreground="#8193A9" TextAlignment="Right" VerticalAlignment="Center"/>
            <Slider x:Name="SeekSlider" Minimum="0" Maximum="1000" Value="0" PreviewMouseDown="Seek_Begin" PreviewMouseUp="Seek_End" IsMoveToPointEnabled="True"/>
          </DockPanel>
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
          <Button x:Name="MuteButton" Content="◖))" Click="Mute_Click" Style="{StaticResource ActionButton}" Margin="0,0,7,0"/>
          <Slider x:Name="VolumeSlider" Minimum="0" Maximum="100" Width="74" Value="75" ValueChanged="Volume_Changed" VerticalAlignment="Center"/>
          <Button Content="⛶" Style="{StaticResource ActionButton}" ToolTip="Fullscreen (F11)" Margin="7,0,0,0" Click="Fullscreen_Click"/>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>