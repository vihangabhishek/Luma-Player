<Window x:Class="NovaPlayer.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vlc="clr-namespace:LibVLCSharp.WinForms;assembly=LibVLCSharp.WinForms"
    xmlns:wfi="clr-namespace:System.Windows.Forms.Integration;assembly=WindowsFormsIntegration"
    Title="Nova Player — Media Player" Width="1170" Height="770" MinWidth="800" MinHeight="570"
    Icon="Assets/NovaPlayer.ico" Background="#F2F4F7" Foreground="#243448"
    WindowStartupLocation="CenterScreen" FontFamily="Segoe UI"
    Closing="Window_Closing" ContentRendered="Window_ContentRendered"
    AllowDrop="True" Drop="Window_Drop">
  <Window.Resources>
    <SolidColorBrush x:Key="Ink" Color="#243448"/>
    <SolidColorBrush x:Key="Muted" Color="#8999B2"/>
    <SolidColorBrush x:Key="Accent" Color="#70ABFF"/>
    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="#233345"/>
      <Setter Property="FontFamily" Value="Segoe UI"/>
    </Style>
    <Style x:Key="NavButton" TargetType="Button">
      <Setter Property="Foreground" Value="#5E6D80"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="14,13"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Margin" Value="0,2"/>
      <Setter Property="Template"><Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="NavBg" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="NavBg" Property="Background" Value="#202D42"/>
              <Setter Property="Foreground" Value="#FFFFFF"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value></Setter>
    </Style>
    <Style x:Key="ActionButton" TargetType="Button">
      <Setter Property="Foreground" Value="#37475B"/>
      <Setter Property="Background" Value="#E7ECF3"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="14,10"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="ButtonBg" Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}">
            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBg" Property="Opacity" Value="0.80"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonBg" Property="Opacity" Value="0.38"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value></Setter>
    </Style>
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
      <Setter Property="Background" Value="#E87C23"/>
      <Setter Property="Foreground" Value="White"/>
    </Style>
    <Style x:Key="PaneCard" TargetType="Border">
      <Setter Property="Background" Value="#FFFFFF"/>
      <Setter Property="BorderBrush" Value="#E1E6EE"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="14"/>
      <Setter Property="Padding" Value="19"/>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Padding" Value="10,9"/>
      <Setter Property="Background" Value="#F9FAFC"/>
      <Setter Property="Foreground" Value="#283747"/>
      <Setter Property="CaretBrush" Value="#FFFFFF"/>
      <Setter Property="BorderBrush" Value="#D6DDE7"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Padding" Value="8,5"/>
      <Setter Property="Background" Value="#27354A"/>
      <Setter Property="Foreground" Value="#283747"/>
    </Style>
    <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#D7E3F4"/></Style>
    <Style TargetType="ListBoxItem">
      <Setter Property="Padding" Value="8"/>
      <Setter Property="Margin" Value="0,3"/>
      <Setter Property="Foreground" Value="#E9F1FC"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Style.Triggers>
        <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#DBE9FC"/></Trigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>
  <Grid x:Name="AppRoot" Background="#F2F4F7">
    <Grid.RowDefinitions><RowDefinition Height="46"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

    <!-- VLC-inspired classic Windows menu: no effects or overlay on the video HWND -->
    <Border x:Name="AppToolbar" Grid.Row="0" Background="#FFFFFF" BorderBrush="#D9E0EA" BorderThickness="0,0,0,1">
      <DockPanel Margin="12,0" LastChildFill="True">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="NOVA PLAYER" Foreground="#59687B" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" Margin="0,0,15,0"/>
          <Button Content="Open file" Click="OpenFiles_Click" Style="{StaticResource PrimaryButton}" Margin="0,0,5,0" Padding="12,7"/>
          <Button Content="Add folder" Click="AddFolder_Click" Style="{StaticResource ActionButton}" Padding="12,7"/>
        </StackPanel>
        <Menu Background="Transparent" Foreground="#263546" VerticalAlignment="Center" BorderThickness="0" FontSize="12">
          <MenuItem Header="_Media">
            <MenuItem Header="Open file..." Click="OpenFiles_Click"/>
            <MenuItem Header="Open network stream..." Click="OpenUrl_Click"/>
            <MenuItem Header="Add folder..." Click="AddFolder_Click"/>
          </MenuItem>
          <MenuItem Header="_Playback">
            <MenuItem Header="Play / Pause" Click="PlayPause_Click"/>
            <MenuItem Header="Fullscreen" Click="Fullscreen_Click"/>
            <MenuItem Header="Add subtitles" Click="Subtitle_Click"/>
          </MenuItem>
          <MenuItem Header="_Help"><MenuItem Header="Check for updates" Click="CheckUpdates_Click"/></MenuItem>
        </Menu>
      </DockPanel>
    </Border>

    <Grid x:Name="ShellGrid" Grid.Row="1" Margin="5">
      <Grid.ColumnDefinitions><ColumnDefinition Width="165"/><ColumnDefinition Width="*"/><ColumnDefinition Width="254"/></Grid.ColumnDefinitions>
      <Border x:Name="NavPanel" Grid.Column="0" Background="#F8FAFC" CornerRadius="5" Padding="8" BorderBrush="#DFE5EC" BorderThickness="1">
        <DockPanel LastChildFill="True">
          <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="EXPLORE" Foreground="#6C7C8F" FontWeight="SemiBold" FontSize="10" Margin="13,19,0,12"/>
            <Button x:Name="NavHome" Content="⌂    Home" Tag="home" Click="Nav_Click" Style="{StaticResource NavButton}" Background="#E8ECF2" Foreground="#28548A"/>
            <Button x:Name="NavMusic" Content="♫    Music" Tag="music" Click="Nav_Click" Style="{StaticResource NavButton}"/>
            <Button x:Name="NavVideos" Content="▶    Videos" Tag="videos" Click="Nav_Click" Style="{StaticResource NavButton}"/>
            <Border Height="1" Background="#E1E7EF" Margin="11,17,11,18"/>
            <TextBlock Text="PREFERENCES" Foreground="#6C7C8F" FontWeight="SemiBold" FontSize="10" Margin="13,0,0,12"/>
            <Button x:Name="NavSettings" Content="⚙    Settings" Tag="settings" Click="Nav_Click" Style="{StaticResource NavButton}"/>
            <Button x:Name="NavUpdates" Content="↓    Updates" Tag="updates" Click="Nav_Click" Style="{StaticResource NavButton}"/>
            <Button x:Name="NavAbout" Content="ⓘ    About" Tag="about" Click="Nav_Click" Style="{StaticResource NavButton}"/>
          </StackPanel>
          <StackPanel DockPanel.Dock="Bottom" VerticalAlignment="Bottom" Margin="8,0,8,8">
            <TextBlock Text="●  PRIVATE &amp; OFFLINE" Foreground="#76B89A" FontSize="10" FontWeight="SemiBold"/>
            <TextBlock Text="v1.4.0 · WINDOWS" Margin="0,12,0,0" Foreground="#687B96" FontSize="10"/>
          </StackPanel>
        </DockPanel>
      </Border>

      <Grid x:Name="MainArea" Grid.Column="1" Margin="5,0">
        <Grid.RowDefinitions><RowDefinition Height="67"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <DockPanel x:Name="TopHeader" Grid.Row="0">
          <TextBlock x:Name="TopStatus" DockPanel.Dock="Right" Text="Ready" Foreground="#798A9E" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="230" TextAlignment="Right"/>
          <StackPanel VerticalAlignment="Center">
            <TextBlock x:Name="PageTitle" Text="Home" FontSize="22" FontWeight="Bold" Foreground="#1D2B3A"/>
            <TextBlock x:Name="PageSubtitle" Text="Everything you love to watch and hear." Margin="0,3,0,0" FontSize="11" Foreground="#8B9CB2"/>
          </StackPanel>
        </DockPanel>
        <Border x:Name="PlayerContainer" Grid.Row="1" Background="#12151B" BorderBrush="#DDE2E8" BorderThickness="1" CornerRadius="2" ClipToBounds="True">
          <Grid>
            <wfi:WindowsFormsHost x:Name="VideoHost" Visibility="Collapsed">
              <vlc:VideoView x:Name="VideoSurface"/>
            </wfi:WindowsFormsHost>
            <Grid x:Name="EmptyVisual" Visibility="Collapsed" Background="#101722">
              <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="▶" FontSize="52" Foreground="#699BEA" HorizontalAlignment="Center"/>
                <TextBlock Text="Ready to play" Foreground="#FFFFFF" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,16,0,7"/>
                <TextBlock Text="Open a movie or song and enjoy the moment." Foreground="#9AABC0" FontSize="12" HorizontalAlignment="Center"/>
                <Button Content="＋ Open media" Click="OpenFiles_Click" Style="{StaticResource PrimaryButton}" Margin="0,22,0,0" HorizontalAlignment="Center"/>
              </StackPanel>
            </Grid>
            <Grid x:Name="MusicVisual" Visibility="Collapsed" Background="#182536">
              <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border Width="142" Height="142" CornerRadius="28" Background="#314B91">
                  <TextBlock Text="♫" FontSize="73" Foreground="#DEEBFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="NOW PLAYING" FontSize="11" FontWeight="SemiBold" Foreground="#88ACDE" HorizontalAlignment="Center" Margin="0,22,0,10"/>
                <TextBlock x:Name="MusicTitle" Text="Music" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="450"/>
              </StackPanel>
            </Grid>

            <!-- Home dashboard, bounded local video preview cards -->
            <Grid x:Name="HomeDashboard" Visibility="Collapsed" Background="#FFFFFF">
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
              <Border Grid.Row="0" Background="#F4F7FB" CornerRadius="14" Padding="22" Margin="20,20,20,18">
                <DockPanel>
                  <Button Content="↻ Refresh" Click="RefreshHome_Click" Style="{StaticResource ActionButton}" DockPanel.Dock="Right" Margin="9,0,0,0"/>
                  <StackPanel>
                    <TextBlock Text="Your cinema" FontSize="24" FontWeight="Bold"/>
                    <TextBlock Text="Movies and clips from your own device." FontSize="12" Foreground="#74869B" Margin="0,7,0,0"/>
                  </StackPanel>
                </DockPanel>
              </Border>
              <DockPanel Grid.Row="1" Margin="24,0,24,12">
                <TextBlock x:Name="HomeVideoCount" DockPanel.Dock="Right" Text="Discovering videos…" Foreground="#7CBEFF" FontSize="11"/>
                <TextBlock x:Name="HomeScanStatus" Text="Scanning your local folders" FontSize="11" Foreground="#718297"/>
              </DockPanel>
              <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="15,0,14,16">
                  <StackPanel x:Name="HomeNoVideos" Visibility="Collapsed" HorizontalAlignment="Center" Margin="0,65,0,0">
                    <TextBlock Text="▸" Foreground="#76A5ED" FontSize="51" HorizontalAlignment="Center"/>
                    <TextBlock Text="No videos found yet" HorizontalAlignment="Center" FontSize="19" FontWeight="SemiBold" Margin="0,14,0,7"/>
                    <TextBlock Text="Open a file or add a folder to get started." HorizontalAlignment="Center" Foreground="#8295B0" FontSize="12" Margin="0,0,0,18"/>
                    <Button Content="＋  Open videos" Style="{StaticResource PrimaryButton}" Click="OpenFiles_Click" HorizontalAlignment="Center"/>
                  </StackPanel>
                  <ItemsControl x:Name="HomeVideosList">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate><DataTemplate>
                      <Button Click="HomeVideo_Click" Width="195" Height="171" Margin="6" Cursor="Hand" Background="Transparent" BorderThickness="0" Padding="0">
                        <Border Background="#F5F7FA" BorderBrush="#D9E1EA" BorderThickness="1" CornerRadius="11" ClipToBounds="True">
                          <StackPanel>
                            <Grid Height="108" Background="#1B2029">
                              <TextBlock Text="▶" FontSize="34" Foreground="#5F8CCC" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                              <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"/>
                              <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="7" Background="#B0101C31" CornerRadius="6" Padding="7,4">
                                <TextBlock Text="▶ Play" Foreground="#FFFFFF" FontSize="10"/>
                              </Border>
                            </Grid>
                            <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" Foreground="#26384A" TextTrimming="CharacterEllipsis" Margin="10,9,10,3"/>
                            <TextBlock Text="{Binding Details}" FontSize="10" Foreground="#8598B4" TextTrimming="CharacterEllipsis" Margin="10,0,10,9"/>
                          </StackPanel>
                        </Border>
                      </Button>
                    </DataTemplate></ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </ScrollViewer>
            </Grid>

            <!-- Proper full-width Music/Videos library, not a blank placeholder -->
            <Grid x:Name="LibraryLanding" Visibility="Collapsed" Background="#FFFFFF">
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
              <Border Grid.Row="0" Background="#F4F7FB" CornerRadius="12" Margin="19" Padding="20">
                <DockPanel>
                  <Border DockPanel.Dock="Left" Width="54" Height="54" CornerRadius="12" Background="#E7EBF2" Margin="0,0,17,0">
                    <TextBlock x:Name="LibraryIcon" Text="♫" FontSize="27" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#344B69"/>
                  </Border>
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="LibraryWelcome" Text="Your music" FontSize="23" FontWeight="SemiBold"/>
                    <TextBlock x:Name="LibraryHint" Text="Double-click any item to start playback." FontSize="11" Foreground="#697D94" Margin="0,6,0,0"/>
                  </StackPanel>
                </DockPanel>
              </Border>
              <DockPanel Grid.Row="1" Margin="23,0,23,12">
                <Button DockPanel.Dock="Right" Content="Add folder" Style="{StaticResource ActionButton}" Click="AddFolder_Click"/>
                <TextBlock Text="LIBRARY ITEMS" FontSize="10" Foreground="#657790" FontWeight="SemiBold" VerticalAlignment="Center"/>
              </DockPanel>
              <ListBox x:Name="LibraryResults" Grid.Row="2" Margin="18,0,18,16" Background="Transparent" BorderThickness="0"
                       ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="True" MouseDoubleClick="LibraryResults_DoubleClick"
                       VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling">
                <ListBox.ItemTemplate><DataTemplate>
                  <Grid Margin="5,5">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions>
                    <Border Width="43" Height="42" CornerRadius="9" Background="#E9EEF4">
                      <TextBlock Text="▶" FontSize="16" Foreground="#8FB9FF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                      <TextBlock Text="{Binding Title}" Foreground="#ECF2FB" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis"/>
                      <TextBlock Text="{Binding Secondary}" Foreground="#73849A" FontSize="11" Margin="0,4,0,0"/>
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="DOUBLE CLICK ▶" Foreground="#6786AF" FontSize="9" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                  </Grid>
                </DataTemplate></ListBox.ItemTemplate>
              </ListBox>
            </Grid>

            <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Background="#FFFFFF">
              <StackPanel MaxWidth="720" Margin="27,25">
                <TextBlock Text="Settings" FontSize="26" FontWeight="Bold"/>
                <TextBlock Text="Your player, your preferences." FontSize="12" Foreground="#63768D" Margin="0,7,0,24"/>
                <Border Style="{StaticResource PaneCard}">
                  <StackPanel>
                    <TextBlock Text="Playback" FontSize="18" FontWeight="SemiBold"/>
                    <CheckBox x:Name="AutoFullscreenCheck" Content="Play videos in fullscreen by default" IsChecked="True" Checked="AutoFullscreen_Changed" Unchecked="AutoFullscreen_Changed" Margin="0,19,0,9" FontSize="13"/>
                    <TextBlock Text="Turn this off to play movies in a window. Press Esc to exit fullscreen." Foreground="#8CA0BB" FontSize="11" TextWrapping="Wrap" Margin="22,0,0,15"/>
                    <TextBlock Text="Accent preset" FontWeight="SemiBold" FontSize="12" Margin="0,4,0,8"/>
                    <ComboBox x:Name="ThemePicker" Width="160" HorizontalAlignment="Left" SelectionChanged="Theme_Changed">
                      <ComboBoxItem Content="Blue" IsSelected="True"/>
                      <ComboBoxItem Content="Violet"/><ComboBoxItem Content="Ocean"/>
                      <ComboBoxItem Content="Rose"/><ComboBoxItem Content="Midnight"/>
                    </ComboBox>
                  </StackPanel>
                </Border>
                <Border Style="{StaticResource PaneCard}" Margin="0,14,0,0">
                  <StackPanel>
                    <TextBlock Text="Local library" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,9"/>
                    <TextBlock Text="Nova only searches your Videos folder, Downloads (top level), and media you add. Local video previews never leave your computer." FontSize="12" Foreground="#687D94" TextWrapping="Wrap"/>
                    <Button Content="↻ Refresh local videos" Style="{StaticResource ActionButton}" Click="RefreshHome_Click" HorizontalAlignment="Left" Margin="0,16,0,0"/>
                  </StackPanel>
                </Border>
              </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="UpdatesPage" Visibility="Collapsed" Background="#FFFFFF" VerticalScrollBarVisibility="Auto">
              <StackPanel MaxWidth="720" Margin="27,25">
                <TextBlock Text="Updates" FontSize="26" FontWeight="Bold"/>
                <TextBlock Text="Simple, secure updates — only when you choose." FontSize="12" Foreground="#63768D" Margin="0,7,0,24"/>
                <Border Style="{StaticResource PaneCard}">
                  <StackPanel>
                    <TextBlock Text="Nova Player 1.4.0" FontSize="21" FontWeight="SemiBold"/>
                    <TextBlock Text="Updates are checked manually and verified using official GitHub SHA-256 checksums before the normal setup wizard runs." Foreground="#687D94" FontSize="12" TextWrapping="Wrap" Margin="0,10,0,18"/>
                    <Button x:Name="CheckUpdatesButton" Content="↻ Check for updates" Click="CheckUpdates_Click" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left"/>
                    <Button x:Name="InstallUpdateButton" Content="↓ Download &amp; install" Click="InstallUpdate_Click" Style="{StaticResource ActionButton}" HorizontalAlignment="Left" Margin="0,12,0,0" Visibility="Collapsed"/>
                    <ProgressBar x:Name="UpdateProgress" Height="7" Margin="0,18,0,0" Minimum="0" Maximum="100" Visibility="Collapsed"/>
                    <TextBlock x:Name="UpdateStatus" Text="You're in control. Updates are never installed silently." FontSize="12" Foreground="#7E8FA3" TextWrapping="Wrap" Margin="0,16,0,0"/>
                  </StackPanel>
                </Border>
              </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="AboutPage" Visibility="Collapsed" Background="#FFFFFF">
              <StackPanel MaxWidth="720" Margin="27,25">
                <TextBlock Text="About Nova Player" FontSize="26" FontWeight="Bold"/>
                <Border Style="{StaticResource PaneCard}" Margin="0,23,0,0">
                  <StackPanel>
                    <Image Source="Assets/NovaPlayer.ico" Width="78" Height="78" HorizontalAlignment="Left" Margin="0,0,0,14"/>
                    <TextBlock Text="Nova Player" FontSize="23" FontWeight="Bold"/>
                    <TextBlock Text="Your media, beautifully simple." FontSize="12" Foreground="#91ACCF" Margin="0,7,0,17"/>
                    <TextBlock Text="Version 1.4.0 · Playback Fix Preview" Foreground="#51647A" FontSize="12"/>
                    <TextBlock Text="A minimal, privacy-focused music and video player powered by LibVLC. Local library previews, fullscreen playback, subtitles, hardware-accelerated decoding where available, and verified in-app updates." TextWrapping="Wrap" FontSize="12" Foreground="#8FA2BE" Margin="0,16,0,0"/>
                    <TextBlock Text="Open source: github.com/vihangabhishek/Luma-Player" FontSize="12" Foreground="#77AEFC" Margin="0,19,0,0"/>
                  </StackPanel>
                </Border>
              </StackPanel>
            </ScrollViewer>
          </Grid>
        </Border>
        <Border x:Name="PlaybackTools" Grid.Row="2" Background="#162132" CornerRadius="12" Padding="11" Margin="0,10,0,0" Visibility="Collapsed">
          <DockPanel LastChildFill="False">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
              <Button Content="Subtitles" Click="Subtitle_Click" Style="{StaticResource ActionButton}" Margin="0,0,7,0"/>
              <Button Content="Snapshot" Click="Snapshot_Click" Style="{StaticResource ActionButton}" Margin="0,0,7,0"/>
              <Button Content="Full screen" Click="Fullscreen_Click" Style="{StaticResource ActionButton}"/>
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Text="Speed" FontSize="11" Foreground="#90A4C0" VerticalAlignment="Center" Margin="0,0,8,0"/>
              <ComboBox x:Name="SpeedPicker" Width="76" SelectionChanged="Speed_Changed">
                <ComboBoxItem Content="0.5×" Tag="0.5"/><ComboBoxItem Content="0.75×" Tag="0.75"/>
                <ComboBoxItem Content="1×" Tag="1" IsSelected="True"/><ComboBoxItem Content="1.25×" Tag="1.25"/>
                <ComboBoxItem Content="1.5×" Tag="1.5"/><ComboBoxItem Content="2×" Tag="2"/>
              </ComboBox>
              <TextBlock Text="Aspect" FontSize="11" Foreground="#90A4C0" VerticalAlignment="Center" Margin="12,0,7,0"/>
              <ComboBox x:Name="AspectPicker" Width="85" SelectionChanged="Aspect_Changed">
                <ComboBoxItem Content="Original" Tag="" IsSelected="True"/>
                <ComboBoxItem Content="16:9" Tag="16:9"/><ComboBoxItem Content="4:3" Tag="4:3"/><ComboBoxItem Content="21:9" Tag="21:9"/>
              </ComboBox>
            </StackPanel>
          </DockPanel>
        </Border>
      </Grid>

      <Border x:Name="LibraryPanel" Grid.Column="2" Background="#F8FAFC" CornerRadius="5" Padding="11" Visibility="Collapsed" BorderBrush="#DFE5EC" BorderThickness="1">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <DockPanel Grid.Row="0" Margin="0,5,0,17">
            <Button DockPanel.Dock="Right" Content="＋" Click="OpenFiles_Click" Style="{StaticResource PrimaryButton}"/>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="Queue" FontSize="17" FontWeight="SemiBold"/>
              <TextBlock x:Name="LibraryCount" Text="0 files" Foreground="#7B8DAA" FontSize="10" Margin="0,5,0,0"/>
            </StackPanel>
          </DockPanel>
          <TextBox x:Name="SearchBox" Grid.Row="1" TextChanged="Search_Changed" ToolTip="Filter queue" Margin="0,0,0,12"/>
          <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,12">
            <Button x:Name="ShuffleButton" Content="Shuffle: Off" Click="Shuffle_Click" Style="{StaticResource ActionButton}" Margin="0,0,6,0"/>
            <Button x:Name="RepeatButton" Content="Repeat: All" Click="Repeat_Click" Style="{StaticResource ActionButton}"/>
          </StackPanel>
          <ListBox x:Name="Playlist" Grid.Row="3" Background="Transparent" BorderThickness="0" MouseDoubleClick="Playlist_DoubleClick" SelectionChanged="Playlist_SelectionChanged"
                   VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True">
            <ListBox.ItemTemplate><DataTemplate>
              <StackPanel Orientation="Horizontal" Margin="1,4">
                <Border Width="34" Height="34" CornerRadius="8" Background="#E7EDF4" Margin="0,0,9,0">
                  <TextBlock Text="♪" FontSize="15" Foreground="#6F8DB4" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Width="171" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Title}" Foreground="#243448" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                  <TextBlock Text="{Binding Secondary}" Foreground="#8497B3" FontSize="10" Margin="0,4,0,0"/>
                </StackPanel>
              </StackPanel>
            </DataTemplate></ListBox.ItemTemplate>
          </ListBox>
          <StackPanel Grid.Row="4" Margin="0,12,0,0">
            <Button Content="♡ Favorite" Click="Favorite_Click" Style="{StaticResource ActionButton}" Margin="0,0,0,7"/>
            <Button Content="Remove from queue" Click="Remove_Click" Style="{StaticResource ActionButton}"/>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>

    <Border x:Name="TransportDock" Grid.Row="2" Background="#FCFDFE" BorderBrush="#DFE5EE" BorderThickness="1,1,0,0" Padding="23,15">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="235"/><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" VerticalAlignment="Center">
          <TextBlock x:Name="NowTitle" Text="Nothing playing" Foreground="#293949" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
          <TextBlock x:Name="NowMeta" Text="Nova Player" Foreground="#7C8BA1" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,5,0,0"/>
        </StackPanel>
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Content="⏮" Click="Previous_Click" Style="{StaticResource ActionButton}" Margin="0,0,7,0"/>
            <Button Content="−10s" Click="Back_Click" Style="{StaticResource ActionButton}" Margin="0,0,7,0"/>
            <Button x:Name="PlayPauseButton" Content="▶ Play" Click="PlayPause_Click" Style="{StaticResource PrimaryButton}" Margin="0,0,7,0"/>
            <Button Content="+10s" Click="Forward_Click" Style="{StaticResource ActionButton}" Margin="0,0,7,0"/>
            <Button Content="⏭" Click="Next_Click" Style="{StaticResource ActionButton}"/>
          </StackPanel>
          <DockPanel Margin="0,9,0,0">
            <TextBlock x:Name="PositionText" Text="00:00" FontSize="11" Foreground="#90A5C0" Width="43" DockPanel.Dock="Left" VerticalAlignment="Center"/>
            <TextBlock x:Name="DurationText" Text="00:00" FontSize="11" Foreground="#90A5C0" Width="43" DockPanel.Dock="Right" TextAlignment="Right" VerticalAlignment="Center"/>
            <Slider x:Name="SeekSlider" Minimum="0" Maximum="1000" IsMoveToPointEnabled="True" PreviewMouseDown="Seek_Begin" PreviewMouseUp="Seek_End"/>
          </DockPanel>
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
          <Button x:Name="MuteButton" Content="◖))" Click="Mute_Click" Style="{StaticResource ActionButton}" Margin="0,0,8,0"/>
          <Slider x:Name="VolumeSlider" Minimum="0" Maximum="100" Width="65" Value="75" ValueChanged="Volume_Changed" VerticalAlignment="Center"/>
          <Button Content="⛶" Click="Fullscreen_Click" Style="{StaticResource ActionButton}" Margin="9,0,0,0"/>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>