<Window x:Class="LumaPlayer.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        Title="Luma Player · Your media, beautifully played" Width="1380" Height="880" MinWidth="900" MinHeight="600"
        Icon="Assets/LumaPlayer.ico" WindowStartupLocation="CenterScreen" Background="#D8E8FE"
        FontFamily="Segoe UI" Closing="Window_Closing" AllowDrop="True" Drop="Window_Drop">
  <Window.Resources>
    <LinearGradientBrush x:Key="BackgroundWash" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#EAF4FF" Offset="0"/><GradientStop Color="#C5DDFF" Offset="0.5"/><GradientStop Color="#E9EAFE" Offset="1"/></LinearGradientBrush>
    <LinearGradientBrush x:Key="GlassSurface" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#FBFDFF" Offset="0"/><GradientStop Color="#EAF3FF" Offset="1"/></LinearGradientBrush>
    <Style x:Key="NavItem" TargetType="Button" BasedOn="{StaticResource SoftButton}"><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Padding" Value="17,14"/><Setter Property="Margin" Value="0,5,0,0"/><Setter Property="Background" Value="Transparent"/><Setter Property="FontSize" Value="14"/></Style>
    <Style x:Key="GlassCard" TargetType="Border"><Setter Property="CornerRadius" Value="21"/><Setter Property="Background" Value="{StaticResource GlassSurface}"/><Setter Property="BorderBrush" Value="#EAF7FF"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="18"/><Setter Property="Effect"><Setter.Value><DropShadowEffect ShadowDepth="3" BlurRadius="14" Opacity="0.1" Color="#335EAD"/></Setter.Value></Setter></Style>
    <Style TargetType="ListBoxItem"><Setter Property="Padding" Value="9"/><Setter Property="Margin" Value="0,2"/><Setter Property="Foreground" Value="#173C6F"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#CEE3FF"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger></Style.Triggers></Style>
  </Window.Resources>
  <Grid Background="{StaticResource BackgroundWash}" x:Name="AppRoot" Margin="0">
    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Grid.Row="0" Margin="19,15,19,6">
      <Grid.ColumnDefinitions><ColumnDefinition Width="214"/><ColumnDefinition Width="*"/><ColumnDefinition Width="290"/></Grid.ColumnDefinitions>
      <!-- navigation -->
      <Border Grid.Column="0" Background="#DDF0FF" CornerRadius="22" Padding="14" BorderBrush="#F5FBFF" BorderThickness="1" Margin="0,0,13,0">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top">
            <StackPanel Orientation="Horizontal" Margin="7,11,0,24"><Border Background="#377FF2" CornerRadius="11" Width="42" Height="42"><TextBlock Text="▶" Foreground="White" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
              <StackPanel Margin="9,2,0,0"><TextBlock Text="Luma" FontSize="19" FontWeight="Bold" Foreground="#153C73"/><TextBlock Text="PLAYER" FontSize="10" FontWeight="Bold" Foreground="#3A85F7"/></StackPanel></StackPanel>
            <TextBlock Text="LIBRARY" Foreground="#6E91BB" FontSize="10" FontWeight="Bold" Margin="11,0,0,8"/>
            <Button Style="{StaticResource NavItem}" Name="AllButton" Background="#C4DFFF" Content="⌂   All media" Click="Filter_Click" Tag="All"/>
            <Button Style="{StaticResource NavItem}" Content="▸   Videos" Click="Filter_Click" Tag="Videos"/>
            <Button Style="{StaticResource NavItem}" Content="♫   Music" Click="Filter_Click" Tag="Music"/>
            <Button Style="{StaticResource NavItem}" Content="♡   Favorites" Click="Filter_Click" Tag="Favorites"/>
            <Button Style="{StaticResource NavItem}" Content="◷   Recently played" Click="Filter_Click" Tag="Recent"/>
            <Border Height="1" Background="#C2D8F3" Margin="9,24,9,19"/>
            <TextBlock Text="ADD MEDIA" Foreground="#6E91BB" FontSize="10" FontWeight="Bold" Margin="11,0,0,8"/>
            <Button Style="{StaticResource NavItem}" Content="＋   Open files" Click="OpenFiles_Click"/>
            <Button Style="{StaticResource NavItem}" Content="▤   Add folder" Click="AddFolder_Click"/>
            <Button Style="{StaticResource NavItem}" Content="⌁   Open network URL" Click="OpenUrl_Click"/>
          </StackPanel>
          <StackPanel DockPanel.Dock="Bottom" VerticalAlignment="Bottom">
            <Border Style="{StaticResource GlassCard}" Padding="12" Margin="0,15,0,0"><StackPanel><TextBlock Text="✦  Beautifully yours" FontSize="13" FontWeight="SemiBold"/><TextBlock Margin="0,7,0,0" Text="Your library stays on this PC.&#10;No account. No tracking." Foreground="#6786AF" FontSize="11"/></StackPanel></Border>
            <ComboBox x:Name="ThemePicker" SelectionChanged="Theme_Changed" Margin="0,12,0,0" ToolTip="Color theme"><ComboBoxItem Content="Blue" IsSelected="True"/><ComboBoxItem Content="Violet"/><ComboBoxItem Content="Ocean"/><ComboBoxItem Content="Rose"/><ComboBoxItem Content="Midnight"/></ComboBox>
            <TextBlock Text="LUMA PLAYER  ·  v1.0" Margin="9,15,0,0" Foreground="#7999BF" FontSize="10"/>
          </StackPanel>
        </DockPanel>
      </Border>
      <!-- center -->
      <Grid Grid.Column="1" Margin="0,0,13,0">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <DockPanel Grid.Row="0" Margin="8,5,0,16"><TextBlock Text="Good moments. Great sound." FontWeight="Bold" FontSize="22" Foreground="#17335D" DockPanel.Dock="Left"/><TextBlock Name="TopStatus" Foreground="#6488B4" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center" Text="Ready to play"/></DockPanel>
        <Border Grid.Row="1" Style="{StaticResource GlassCard}" Margin="0,0,0,15" Padding="21,18">
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="155"/></Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0"><TextBlock Text="YOUR OWN CINEMA &amp; MUSIC SPACE" Foreground="#4280D9" FontSize="10" FontWeight="Bold"/><TextBlock Text="Luma Player" Foreground="#1B4178" FontSize="29" FontWeight="Bold" Margin="0,5,0,1"/><TextBlock Text="4K-ready playback engine · Your files, your rules." Foreground="#7795B8" FontSize="12"/></StackPanel>
            <TextBlock Grid.Column="1" Text="✦  ▶  ♪" FontSize="46" Foreground="#569AFF" Opacity="0.6" HorizontalAlignment="Right" VerticalAlignment="Center"/>
          </Grid>
        </Border>
        <Border Grid.Row="2" Background="#101D37" BorderBrush="#E4F2FF" BorderThickness="2" CornerRadius="18" ClipToBounds="True">
          <Grid>
            <vlc:VideoView x:Name="VideoSurface" Visibility="Collapsed" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
            <Grid x:Name="EmptyVisual" Background="#101C32"><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="▶" Foreground="#86B6FF" FontSize="66" HorizontalAlignment="Center"/><TextBlock Text="The next scene starts here." Foreground="White" FontSize="21" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,16,0,7"/><TextBlock Text="Open a movie, drop media here, or choose from your library." Foreground="#9AB5DA" FontSize="12" HorizontalAlignment="Center"/><Button Content="＋  Open media" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Center" Margin="0,25,0,0" Click="OpenFiles_Click"/></StackPanel></Grid>
            <Grid x:Name="MusicVisual" Visibility="Collapsed" Background="#172A52"><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><Border Width="180" Height="180" Background="#386CCA" CornerRadius="28"><TextBlock Text="♫" FontSize="95" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="Now playing" Foreground="#C9DEFF" HorizontalAlignment="Center" Margin="0,24,0,6" FontSize="13"/><TextBlock x:Name="MusicTitle" Foreground="White" HorizontalAlignment="Center" FontSize="19" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="360"/></StackPanel></Grid>
          </Grid>
        </Border>
        <Border Grid.Row="3" Style="{StaticResource GlassCard}" Padding="12" Margin="0,11,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="Playback" FontSize="12" FontWeight="SemiBold" Margin="0,0,10,0" VerticalAlignment="Center"/>
            <Button Style="{StaticResource SoftButton}" Content="Subtitles" Click="Subtitle_Click" Margin="0,0,5,0"/>
            <Button Style="{StaticResource SoftButton}" Content="Screenshot" Click="Snapshot_Click" Margin="0,0,5,0"/>
            <Button Style="{StaticResource SoftButton}" Content="Fullscreen" Click="Fullscreen_Click"/></StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="Speed" VerticalAlignment="Center" Margin="0,0,7,0" FontSize="11"/><ComboBox Width="78" x:Name="SpeedPicker" SelectionChanged="Speed_Changed"><ComboBoxItem Content="0.5×" Tag="0.5"/><ComboBoxItem Content="0.75×" Tag="0.75"/><ComboBoxItem Content="1.0×" Tag="1" IsSelected="True"/><ComboBoxItem Content="1.25×" Tag="1.25"/><ComboBoxItem Content="1.5×" Tag="1.5"/><ComboBoxItem Content="2.0×" Tag="2"/></ComboBox>
            <TextBlock Text="Aspect" VerticalAlignment="Center" Margin="13,0,7,0" FontSize="11"/><ComboBox Width="92" Name="AspectPicker" SelectionChanged="Aspect_Changed"><ComboBoxItem Content="Original" Tag="" IsSelected="True"/><ComboBoxItem Content="16:9" Tag="16:9"/><ComboBoxItem Content="4:3" Tag="4:3"/><ComboBoxItem Content="21:9" Tag="21:9"/></ComboBox>
          </StackPanel>
        </Grid></Border>
      </Grid>
      <!-- right -->
      <Border Grid.Column="2" Style="{StaticResource GlassCard}" Padding="16">
        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <DockPanel Grid.Row="0" Margin="0,0,0,15"><StackPanel DockPanel.Dock="Left"><TextBlock Text="Your Library" FontWeight="Bold" FontSize="18"/><TextBlock x:Name="LibraryCount" Text="0 items" FontSize="11" Foreground="#7A98BF" Margin="0,4,0,0"/></StackPanel><Button Content="＋" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" Click="OpenFiles_Click"/></DockPanel>
          <TextBox Grid.Row="1" Name="SearchBox" TextChanged="Search_Changed" ToolTip="Search files in your library" Margin="0,0,0,12" />
          <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,11"><Button Content="Shuffle: Off" Name="ShuffleButton" Style="{StaticResource SoftButton}" Click="Shuffle_Click" Margin="0,0,6,0"/><Button Content="Repeat: All" Name="RepeatButton" Style="{StaticResource SoftButton}" Click="Repeat_Click"/></StackPanel>
          <ListBox Grid.Row="3" Name="Playlist" BorderThickness="0" Background="Transparent" MouseDoubleClick="Playlist_DoubleClick" SelectionChanged="Playlist_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemTemplate><DataTemplate><Grid Margin="1,2"><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Background="#DBEBFF" Width="30" Height="34" CornerRadius="9"><TextBlock Text="▶" Foreground="#4B89EA" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" Margin="7,0,0,0"><TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="180"/><TextBlock Text="{Binding Secondary}" Foreground="#7B99BB" FontSize="10" Margin="0,3,0,0"/></StackPanel></Grid></DataTemplate></ListBox.ItemTemplate></ListBox>
          <StackPanel Grid.Row="4" Margin="0,12,0,0"><Button Content="♡  Toggle favorite" Style="{StaticResource SoftButton}" Click="Favorite_Click" Margin="0,0,0,7"/><Button Content="Remove from library" Style="{StaticResource SoftButton}" Click="Remove_Click"/></StackPanel>
        </Grid>
      </Border>
    </Grid>
    <!-- transport dock -->
    <Border Grid.Row="1" Background="#EAF3FF" BorderBrush="#F8FDFF" BorderThickness="1" CornerRadius="19" Margin="19,2,19,13" Padding="17,11">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="240"/><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" VerticalAlignment="Center"><TextBlock x:Name="NowTitle" Text="Nothing playing yet" FontSize="14" FontWeight="Bold" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="NowMeta" Text="Luma Player" FontSize="11" Foreground="#7995BB" Margin="0,4,0,0"/></StackPanel>
        <StackPanel Grid.Column="1" VerticalAlignment="Center"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><Button Style="{StaticResource SoftButton}" Content="⏮" FontSize="17" Click="Previous_Click" Margin="0,0,8,0"/><Button Style="{StaticResource SoftButton}" Content="↶ 10s" Click="Back_Click" Margin="0,0,8,0"/><Button Style="{StaticResource PrimaryButton}" Name="PlayPauseButton" Content="▶  Play" Click="PlayPause_Click" FontSize="14" Margin="0,0,8,0"/><Button Style="{StaticResource SoftButton}" Content="10s ↷" Click="Forward_Click" Margin="0,0,8,0"/><Button Style="{StaticResource SoftButton}" Content="⏭" FontSize="17" Click="Next_Click"/></StackPanel>
          <DockPanel Margin="0,7,0,0"><TextBlock Name="PositionText" Text="00:00" Width="45" VerticalAlignment="Center" FontSize="11"/><TextBlock Name="DurationText" Text="00:00" DockPanel.Dock="Right" Width="45" FontSize="11" VerticalAlignment="Center" TextAlignment="Right"/><Slider Name="SeekSlider" Minimum="0" Maximum="1000" Value="0" PreviewMouseDown="Seek_Begin" PreviewMouseUp="Seek_End" IsMoveToPointEnabled="True"/></DockPanel>
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right"><Button Content="◖))" Name="MuteButton" Style="{StaticResource SoftButton}" Click="Mute_Click" Margin="0,0,10,0"/><Slider Width="100" Minimum="0" Maximum="100" Value="75" Name="VolumeSlider" ValueChanged="Volume_Changed" VerticalAlignment="Center"/><Button Content="⛶" ToolTip="Fullscreen (F11)" Style="{StaticResource SoftButton}" Margin="9,0,0,0" Click="Fullscreen_Click"/></StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
